{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Student profile registered with authentication",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "displayName": { "type": "string", "description": "Student display name" },
        "photoURL": { "type": "string", "description": "Avatar URL" },
        "createdAt": { "type": "string", "description": "Account registration timestamp" }
      },
      "required": ["uid", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Logged college expense record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique transaction ID" },
        "userId": { "type": "string", "description": "UID of student owner" },
        "date": { "type": "string", "description": "Expense date YYYY-MM-DD" },
        "description": { "type": "string", "maxLength": 200, "description": "Expense title or item name" },
        "amount": { "type": "number", "description": "Monetary cost amount" },
        "category": {
          "type": "string",
          "enum": ["Food", "Transport", "Education", "Accommodation", "Shopping", "Entertainment", "Health", "Others"],
          "description": "Expense category"
        },
        "source": { "type": "string", "maxLength": 100, "description": "Source method or account" },
        "notes": { "type": "string", "maxLength": 500, "description": "Optional notes or tags" },
        "createdAt": { "type": "string", "description": "Created timestamp" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      },
      "required": ["id", "userId", "date", "description", "amount", "category", "source"]
    },
    "BudgetConfig": {
      "title": "BudgetConfig",
      "description": "Student monthly spending limits and category allocations",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of student owner" },
        "monthlyBudget": { "type": "number", "description": "Overall monthly budget limit" },
        "currency": { "type": "string", "maxLength": 5, "description": "Currency symbol" },
        "categoryBudgets": { "type": "object", "description": "Optional category cap allocations" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      },
      "required": ["userId", "monthlyBudget", "currency"]
    },
    "SavingsGoal": {
      "title": "SavingsGoal",
      "description": "Target savings milestone for college",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of student owner" },
        "name": { "type": "string", "maxLength": 100, "description": "Goal name or target purchase" },
        "savedAmount": { "type": "number", "description": "Current amount saved" },
        "targetAmount": { "type": "number", "description": "Target cost goal" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      },
      "required": ["userId", "name", "savedAmount", "targetAmount"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user account profile document"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Personal expense transactions subcollection"
    },
    "/users/{userId}/budget/current": {
      "schema": "BudgetConfig",
      "description": "Student budget preferences document"
    },
    "/users/{userId}/savingsGoal/current": {
      "schema": "SavingsGoal",
      "description": "Student savings goal target document"
    }
  }
}
